                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Resize mode:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="resizeModeDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Image Presets Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Quality Presets</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                <property name="homogeneous">true</property>
                                
                                <child>
                                  <object class="GtkButton" id="imageHighQualityButton">
                                    <property name="label" translatable="yes">High Quality</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="imageBalancedButton">
                                    <property name="label" translatable="yes">Balanced</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="imageSmallSizeButton">
                                    <property name="label" translatable="yes">Small Size</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Image</property>
                  </object>
                </property>
              </object>
            </child>
            
            <!-- ============================================ -->
            <!-- DOCUMENT SETTINGS TAB -->
            <!-- ============================================ -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="spacing">18</property>
                        
                        <!-- Preset Management Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Preset Management</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Saved Presets:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkComboBoxText" id="docPresetCombo">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="docSavePresetButton">
                                    <property name="label" translatable="yes">Save</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="docDeletePresetButton">
                                    <property name="label" translatable="yes">Delete</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Document Output Format Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Output Format</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Format:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="documentFormatDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Template Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Template</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Template file:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkEntry" id="templateFileEntry">
                                    <property name="hexpand">true</property>
                                    <property name="editable">false</property>
                                    <property name="placeholder-text" translatable="yes">No template (optional)</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="templateFileButton">
                                    <property name="icon-name">document-open-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Choose template file</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="clearTemplateButton">
                                    <property name="icon-name">edit-clear-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Clear template</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Optional template for document formatting</property>
                                <property name="xalign">0</property>
                                <property name="margin-start">20</property>
                                <style>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Formatting Options Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Formatting Options</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkCheckButton" id="preserveFormattingCheckbox">
                                <property name="label" translatable="yes">Preserve formatting</property>
                                <property name="active">true</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkCheckButton" id="embedFontsCheckbox">
                                <property name="label" translatable="yes">Embed fonts (PDF output)</property>
                                <property name="active">false</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkCheckButton" id="generateTocCheckbox">
                                <property name="label" translatable="yes">Generate table of contents</property>
                                <property name="active">false</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Page Margins Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Page Margins</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <!-- Top Margin -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Top:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkSpinButton" id="marginTopSpinButton">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="marginTopAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="value">25</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">5</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">mm</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Bottom Margin -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Bottom:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkSpinButton" id="marginBottomSpinButton">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="marginBottomAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="value">25</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">5</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">mm</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Left Margin -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Left:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkSpinButton" id="marginLeftSpinButton">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="marginLeftAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="value">25</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">5</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">mm</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Right Margin -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Right:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkSpinButton" id="marginRightSpinButton">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="marginRightAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="value">25</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">5</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">mm</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Document</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
