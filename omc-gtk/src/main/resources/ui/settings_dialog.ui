<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  
  <!-- Settings Dialog -->
  <object class="GtkDialog" id="settingsDialog">
    <property name="title" translatable="yes">Settings</property>
    <property name="modal">true</property>
    <property name="default-width">700</property>
    <property name="default-height">600</property>
    <property name="resizable">true</property>
    
    <!-- Header Bar -->
    <child type="titlebar">
      <object class="GtkHeaderBar" id="settingsHeaderBar">
        <property name="show-title-buttons">false</property>
        
        <!-- Cancel Button -->
        <child type="start">
          <object class="GtkButton" id="cancelButton">
            <property name="label" translatable="yes">Cancel</property>
          </object>
        </child>
        
        <!-- Save Button -->
        <child type="end">
          <object class="GtkButton" id="saveButton">
            <property name="label" translatable="yes">Save</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    
    <!-- Dialog Content -->
    <child>
      <object class="GtkBox" id="dialogContentBox">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        
        <!-- Tabbed Settings Notebook -->
        <child>
          <object class="GtkNotebook" id="settingsNotebook">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            
            <!-- ============================================ -->
            <!-- GENERAL SETTINGS TAB -->
            <!-- ============================================ -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="spacing">18</property>
                        

                        <!-- Interface language -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Language</property>
                                <property name="xalign">0</property>
                                <style><class name="heading"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="languageDropdown">
                                <property name="hexpand">true</property>
                                <property name="tooltip-text" translatable="yes">Choose the application language</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Restart the application to apply the language change.</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <style><class name="dim-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Output Directory Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Output Directory</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Directory:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkEntry" id="outputDirectoryEntry">
                                    <property name="hexpand">true</property>
                                    <property name="editable">false</property>
                                    <property name="placeholder-text" translatable="yes">Choose output directory...</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="outputDirectoryButton">
                                    <property name="icon-name">folder-open-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Choose output directory</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Output Options Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Output Options</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkCheckButton" id="overwriteExistingCheckbox">
                                <property name="label" translatable="yes">Overwrite existing files</property>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkCheckButton" id="createSubdirectoryCheckbox">
                                <property name="label" translatable="yes">Create subdirectory for each format</property>
                              </object>
                            </child>
                            
                            <!-- Delete Original File Checkbox (Requirement REQ-GEN-1.1) -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                
                                <child>
                                  <object class="GtkCheckButton" id="deleteOriginalFileCheckbox">
                                    <property name="label" translatable="yes">Delete original file after successful conversion</property>
                                    <property name="tooltip-text" translatable="yes">⚠️ Warning: This will permanently delete source files. Use with caution!</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">dialog-warning-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">⚠️ Warning: This will permanently delete source files. Use with caution!</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Parallel Conversions Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Performance</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Parallel conversions:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkSpinButton" id="parallelConversionsSpinButton">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="parallelConversionsAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">16</property>
                                        <property name="value">2</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">2</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">  (1-16)</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">General</property>
                  </object>
                </property>
              </object>
            </child>
            
            <!-- ============================================ -->
            <!-- VIDEO SETTINGS TAB -->
            <!-- ============================================ -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="spacing">18</property>
                        
                        <!-- Preset Management Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Preset Management</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Saved Presets:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="videoPresetCombo">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="videoSavePresetButton">
                                    <property name="label" translatable="yes">Save</property>
                                    <property name="tooltip-text" translatable="yes">Save current settings as a preset</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="videoDeletePresetButton">
                                    <property name="label" translatable="yes">Delete</property>
                                    <property name="tooltip-text" translatable="yes">Delete selected preset</property>
                                    <style>
                                      <class name="destructive-action"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Output Format Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Output Format</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Format:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="videoFormatDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Video Codec Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Video Codec</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Codec:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="videoCodecDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Video Resolution Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Resolution</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Resolution:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="videoResolutionDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            
                            <!-- Custom Resolution Entry -->
                            <child>
                              <object class="GtkBox" id="customResolutionBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                <property name="visible">false</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Custom:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkEntry" id="videoWidthEntry">
                                    <property name="placeholder-text" translatable="yes">Width</property>
                                    <property name="width-chars">8</property>
                                    <property name="input-purpose">number</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">×</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkEntry" id="videoHeightEntry">
                                    <property name="placeholder-text" translatable="yes">Height</property>
                                    <property name="width-chars">8</property>
                                    <property name="input-purpose">number</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                         </child>
                         
                         <!-- Video Aspect Ratio Section -->
                         <child>
                           <object class="GtkBox">
                             <property name="orientation">vertical</property>
                             <property name="spacing">12</property>
                             
                             <child>
                               <object class="GtkLabel">
                                 <property name="label" translatable="yes">Aspect Ratio</property>
                                 <property name="xalign">0</property>
                                 <style>
                                   <class name="heading"/>
                                 </style>
                               </object>
                             </child>
                             
                             <child>
                               <object class="GtkBox">
                                 <property name="orientation">horizontal</property>
                                 <property name="spacing">12</property>
                                 
                                 <child>
                                   <object class="GtkLabel">
                                     <property name="label" translatable="yes">Aspect ratio:</property>
                                     <property name="xalign">0</property>
                                     <property name="width-chars">20</property>
                                   </object>
                                 </child>
                                 
                                 <child>
                                   <object class="GtkDropDown" id="videoAspectRatioDropdown">
                                     <property name="hexpand">true</property>
                                   </object>
                                 </child>
                               </object>
                             </child>
                           </object>
                         </child>
                         
                         <!-- Video Bitrate Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Bitrate</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Bitrate:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkSpinButton" id="videoBitrateSpinButton">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="videoBitrateAdjustment">
                                        <property name="lower">500</property>
                                        <property name="upper">50000</property>
                                        <property name="value">5000</property>
                                        <property name="step-increment">100</property>
                                        <property name="page-increment">1000</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">kbps</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Video Frame Rate Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Frame Rate</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Frame rate:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="videoFrameRateDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Video Preset Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Encoding Preset</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Preset:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkDropDown" id="videoPresetDropdown">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- CRF Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Constant Rate Factor (CRF)</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">CRF:</property>
                                    <property name="xalign">0</property>
                                    <property name="width-chars">20</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkScale" id="videoCrfScale">
                                    <property name="hexpand">true</property>
                                    <property name="draw-value">true</property>
                                    <property name="value-pos">right</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment" id="videoCrfAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">51</property>
                                        <property name="value">23</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">5</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Lower values = higher quality, larger file size</property>
                                <property name="xalign">0</property>
                                <property name="margin-start">20</property>
                                <style>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        
                        <!-- Quality Presets Section -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Quality Presets</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                <property name="homogeneous">true</property>
                                
                                <child>
                                  <object class="GtkButton" id="videoHighQualityButton">
                                    <property name="label" translatable="yes">High Quality</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="videoBalancedButton">
                                    <property name="label" translatable="yes">Balanced</property>
                                  </object>
                                </child>
                                
                                <child>
                                  <object class="GtkButton" id="videoSmallSizeButton">
                                    <property name="label" translatable="yes">Small Size</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Video</property>
                  </object>
                </property>
              </object>
            </child>
            
            <!-- ============================================ -->
            <!-- AUDIO SETTINGS TAB -->
            <!-- ============================================ -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="spacing">18</property>
                        
                        <!-- Preset Management Section -->
