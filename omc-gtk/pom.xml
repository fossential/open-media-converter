<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.omc</groupId>
        <artifactId>omc</artifactId>
        <version>0.1.2</version>
    </parent>
    <artifactId>omc-gtk</artifactId>
    <packaging>jar</packaging>
    <name>omc-gtk</name>
    <description>The GTK UI of the Open Media Converter</description>

    <properties>
        <omc.skipEmbeddedTools>false</omc.skipEmbeddedTools>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.omc</groupId>
            <artifactId>omc-core</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
        </dependency>

        <!-- GTK 4 bindings via java-gi (version managed by parent) -->
        <dependency>
            <groupId>io.github.jwharm.javagi</groupId>
            <artifactId>gtk</artifactId>
        </dependency>

        <!-- Application logging and the bridge for JDK/library diagnostics;
             versions managed by parent -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
        </dependency>

        <!-- Testing dependencies (versions managed by parent) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
              <!-- Maven Compiler Plugin for Java 23 (release/source/target
                   are inherited from the parent properties; plugin versions
                   managed by the parent) -->
               <plugin>
                   <groupId>org.apache.maven.plugins</groupId>
                   <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <showWarnings>true</showWarnings>
                        <showDeprecation>true</showDeprecation>
                    </configuration>
               </plugin>

             <!-- Maven Surefire Plugin for running tests; @{argLine} lets the
                  JaCoCo agent prepend itself -->
             <plugin>
                 <groupId>org.apache.maven.plugins</groupId>
                 <artifactId>maven-surefire-plugin</artifactId>
                 <configuration>
                     <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                 </configuration>
             </plugin>

             <!-- Maven Shade Plugin for creating the fat JAR (replaces the
                  former maven-assembly jar-with-dependencies build) -->
             <plugin>
                 <groupId>org.apache.maven.plugins</groupId>
                 <artifactId>maven-shade-plugin</artifactId>
                 <configuration>
                    <!-- Reproduces the assembly output layout: the fat jar is
                         written to target/open-media-converter-<version>.jar
                         while the plain module jar is left untouched (because
                         this finalName differs from the build finalName, no
                         main-artifact replacement is performed). -->
                    <finalName>open-media-converter-${project.version}</finalName>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters>
                        <!-- Strip jar signatures: a signed entry inside an
                             uber-jar breaks the JAR verifier -->
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <!-- Merge META-INF/services descriptors across jars -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <!-- shade 3.6.x has no <archive> parameter; the
                             ManifestResourceTransformer reproduces the
                             manifest the assembly plugin used to emit
                             (Main-Class plus implementation/specification
                             and application entries). Applied last so its
                             entries win merge conflicts. -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>org.omc.ui.MainApplicationJavaGi</mainClass>
                            <manifestEntries>
                                <Specification-Title>${project.name}</Specification-Title>
                                <Specification-Version>${project.artifact.selectedVersion.majorVersion}.${project.artifact.selectedVersion.minorVersion}</Specification-Version>
                                <Implementation-Title>${project.name}</Implementation-Title>
                                <Implementation-Version>${project.version}</Implementation-Version>
                                <Built-By>Open Media Converter Team</Built-By>
                                <Build-Time>${maven.build.timestamp}</Build-Time>
                                <Application-Name>Open Media Converter</Application-Name>
                                <Application-Version>${project.version}</Application-Version>
                            </manifestEntries>
                        </transformer>
                    </transformers>
                    <!-- minimizeJar intentionally NOT used: it breaks
                         reflection-heavy code (Jackson, java-gi). No
                         relocations: no conflicting deps on the classpath. -->
                </configuration>
                <executions>
                    <execution>
                        <id>make-shaded-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

             <!-- Maven Resources Plugin -->
             <plugin>
                 <groupId>org.apache.maven.plugins</groupId>
                 <artifactId>maven-resources-plugin</artifactId>
                 <configuration>
                     <encoding>UTF-8</encoding>
                 </configuration>
             </plugin>

             <!-- JaCoCo coverage agent + report -->
             <plugin>
                 <groupId>org.jacoco</groupId>
                 <artifactId>jacoco-maven-plugin</artifactId>
                 <executions>
                     <execution>
                         <goals><goal>prepare-agent</goal></goals>
                     </execution>
                     <execution>
                         <id>report</id>
                         <phase>test</phase>
                         <goals><goal>report</goal></goals>
                     </execution>
                 </executions>
             </plugin>

             <!-- Maven Exec Plugin for running the application -->
             <plugin>
                 <groupId>org.codehaus.mojo</groupId>
                 <artifactId>exec-maven-plugin</artifactId>
                 <configuration>
                    <mainClass>org.omc.ui.MainApplicationJavaGi</mainClass>
                </configuration>
                <executions>
                    <!-- Run packaging scripts during deploy phase -->
                    <execution>
                        <id>prepare-embedded-tools</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${omc.skipEmbeddedTools}</skip>
                            <executable>python3</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/prepare-tools.py</argument>
                                <argument>--offline=${settings.offline}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Distribution packages (DEB/RPM/Arch/AppImage) are NOT
                         built during a normal `mvn deploy`: the packaging
                         toolchain is host-specific and often unavailable.
                         Activate explicitly with -Prelease-packages. -->
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!-- Opt-in packaging runs: mvn deploy -Prelease-packages -->
            <id>release-packages</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-packages</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>packaging/build-packages.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>embedded-tools</id>
            <activation>
                <property><name>omc.skipEmbeddedTools</name><value>!true</value></property>
            </activation>
            <build>
                <resources>
                    <resource><directory>src/main/resources</directory></resource>
                    <resource><directory>.tool-cache/resources</directory></resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
