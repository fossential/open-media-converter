[Desktop Entry]
Version=1.0
Type=Application
Name=Open Media Converter
GenericName=Media Converter
GenericName[fr]=Convertisseur multimédia
GenericName[es]=Conversor multimedia
GenericName[de]=Medienkonverter
GenericName[pt]=Conversor multimédia
GenericName[zh_CN]=媒体转换器
GenericName[ja]=メディア変換
Comment=Convert video, audio, image and document formats
Comment[es]=Convierte formatos de video, audio, imagen y documentos
Comment[fr]=Convertir des formats vidéo, audio, image et document
Comment[de]=Video-, Audio-, Bild- und Dokumentformate konvertieren
Comment[pt]=Converter formatos de vídeo, áudio, imagem e documentos
Comment[zh_CN]=转换视频、音频、图像和文档格式
Comment[ja]=動画・音声・画像・ドキュメントの形式を変換

# Executable and icon
Exec=/usr/bin/open-media-converter %F
Icon=open-media-converter
TryExec=/usr/bin/open-media-converter
Terminal=false

# Desktop categories
Categories=AudioVideo;Audio;Video;Graphics;Office;Utility;GTK;

# Startup and display
StartupNotify=true
StartupWMClass=open-media-converter
Keywords=media;convert;video;audio;image;document;transcode;ffmpeg;

# MIME type associations for all supported formats
MimeType=video/mp4;video/x-matroska;video/x-msvideo;video/quicktime;video/x-ms-wmv;video/x-flv;video/webm;video/ogg;video/mpeg;video/3gpp;video/x-m4v;audio/mpeg;audio/mp4;audio/x-wav;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/aac;audio/x-aiff;audio/x-ms-wma;audio/x-m4a;image/jpeg;image/png;image/gif;image/bmp;image/webp;image/tiff;image/x-icon;image/svg+xml;image/vnd.microsoft.icon;application/pdf;application/vnd.oasis.opendocument.text;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;application/rtf;application/vnd.oasis.opendocument.presentation;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.spreadsheet;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;text/markdown;text/html;text/plain;application/x-yaml;application/json;application/epub+zip;

# Actions for quick access
Actions=ConvertFiles;OpenSettings;

[Desktop Action ConvertFiles]
Name=Convert Files
Name[es]=Convertir archivos
Name[fr]=Convertir des fichiers
Name[de]=Dateien konvertieren
Name[pt]=Converter ficheiros
Name[zh_CN]=转换文件
Name[ja]=ファイルを変換
Exec=/usr/bin/open-media-converter

[Desktop Action OpenSettings]
Name=Open Settings
Name[es]=Abrir configuración
Name[fr]=Ouvrir les paramètres
Name[de]=Einstellungen öffnen
Name[pt]=Abrir definições
Name[zh_CN]=打开设置
Name[ja]=設定を開く
Exec=/usr/bin/open-media-converter --settings
